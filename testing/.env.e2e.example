# Copy to .env.e2e (or export in your shell) before running the E2E suite.
# These are LOCAL DEV values only — see CLAUDE.md.

# Frontend under test
E2E_BASE_URL=http://localhost:3000

# Backend API the browser talks to (for direct Burp re-probes / sanity)
E2E_API_URL=http://localhost:7080

# Seed users created locally (not in the original dump)
E2E_ADMIN_LOGIN=seed.admin
E2E_ADMIN_PASSWORD=Admin@123456
E2E_SUPER_LOGIN=seed.super
E2E_SUPER_PASSWORD=Super@123456

# Burp proxy listener — set this to route browser + dev-server traffic through
# Burp so every request lands in the proxy history for the review loop.
# Leave UNSET to run the suite without Burp.
# BURP_PROXY=http://127.0.0.1:8383

# Postgres (host-mapped) for the DB-verification step (via Postgres MCP).
# Confirm the postgres-full MCP is pointed here (db AttendanceDb).
E2E_PG_HOST=localhost
E2E_PG_PORT=5435
E2E_PG_DB=AttendanceDb
E2E_PG_USER=postgres
E2E_PG_PASSWORD=postgres
