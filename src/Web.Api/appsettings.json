{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 0
  },
  "TimeZone": {
    "Id": "Asia/Baghdad"
  },
  "Security": {
    "RateLimiting": {
      "MaxRequestsPerMinute": 160,
      "MaxRequestsPerHour": 1000,
      "BlockDurationMinutes": 15,
      "Enabled": true
    },
    "IpBlocking": {
      "MaxFailedAttemptsBeforeBlock": 10,
      "SuspiciousActivityWindowMinutes": 15,
      "BlockDurationHours": 24,
      "Enabled": true,
      "WhitelistedIps": [
        "127.0.0.1",
        "::1"
      ]
    },
    "RequestValidation": {
      "MaxRequestSize": 10485760,
      "MaxHeaderLength": 8192,
      "MaxUrlLength": 2048,
      "Enabled": true,
      "ExcludedPaths": [
        "/health",
        "/swagger"
      ]
    },
    "SecurityHeaders": {
      "Enabled": true,
      "StrictTransportSecurityMaxAge": 31536000,
      "EnableHstsPreload": true,
      "CustomHeaders": {}
    }
  }
}
