{
  "ConnectionStrings": {
    "Database": "",
    "Cache": "",
    "BlobStorage": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Web.Api.Middleware": "Information"
      }
    },
    "WriteTo": [
      { 
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 480
  },
  "TimeZone": {
    "Id": "Asia/Baghdad"
  },
  "Security": {
    "RateLimiting": {
      "MaxRequestsPerMinute": 30,
      "MaxRequestsPerHour": 500,
      "BlockDurationMinutes": 30,
      "Enabled": true
    },
    "IpBlocking": {
      "MaxFailedAttemptsBeforeBlock": 5,
      "SuspiciousActivityWindowMinutes": 10,
      "BlockDurationHours": 24,
      "Enabled": true,
      "WhitelistedIps": [
        "127.0.0.1",
        "::1"
      ]
    },
    "RequestValidation": {
      "MaxRequestSize": 5242880,
      "MaxHeaderLength": 4096,
      "MaxUrlLength": 1024,
      "Enabled": true,
      "ExcludedPaths": [
        "/health"
      ]
    },
    "SecurityHeaders": {
      "Enabled": true,
      "StrictTransportSecurityMaxAge": 63072000,
      "EnableHstsPreload": true,
      "CustomHeaders": {
        "Server": "",
        "X-Powered-By": ""
      }
    }
  }
}
